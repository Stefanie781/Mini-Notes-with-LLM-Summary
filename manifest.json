{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "tool-dev-mini-notes-summarizer",
      "min_version": "1.0.0"
    }
  ],
  "optional_executas": [],
  "permissions": ["storage.read", "storage.write", "tools.invoke"],
  "host_capabilities": ["llm.complete"],
  "system_prompt_addendum": "The user has the Mini Notes app open. Notes live in the app's Anna storage under the key 'mini-notes:notes' (an array of {id, order, text, created_at}). When the user asks for a summary of their notes, invoke the bundled Executa tool 'tool-dev-mini-notes-summarizer' (method 'summarize'); it borrows the host LLM via sampling and returns the summary. Never invent a summary yourself.",
  "user_message_prefix_template": "[Mini Notes] {user_message}",
  "tags": ["productivity", "notes", "summary"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Mini Notes",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 360, "h": 480 },
        "default_size": { "w": 520, "h": 720 },
        "max_size": { "w": 1200, "h": 1600 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["tool-dev-mini-notes-summarizer"],
      "storage": ["get", "set", "delete", "list"],
      "llm": ["complete"],
      "window": ["set_title"]
    },
    "csp_overrides": {
      "img-src": ["'self'", "data:"],
      "font-src": ["'self'", "data:"],
      "style-src": ["'self'"],
      "script-src": ["'self'"]
    }
  },
  "dev": {
    "seed_storage": {
      "mini-notes:notes": []
    },
    "user_id": 1
  }
}
