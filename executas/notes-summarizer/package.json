{
  "name": "mini-notes-summarizer",
  "version": "1.0.0",
  "description": "Executa tool that summarizes Mini Notes via host LLM sampling (JSON-RPC 2.0 over stdio).",
  "license": "MIT",
  "bin": {
    "mini-notes-summarizer": "./server.js"
  },
  "executa": {
    "tool_id": "tool-dev-mini-notes-summarizer",
