    "package": "bash ../../scripts/build-binary.sh",
    "package:test": "bash ../../scripts/build-binary.sh --test",
    "test:protocol": "node ../../scripts/test-protocol.js"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.0"
  }
}
